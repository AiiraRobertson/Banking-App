# Copy to .env and adjust as needed
BASE_URL=http://localhost:5173
API_URL=http://localhost:3001

# Seeded test users (must exist in the dev DB)
TEST_USER_EMAIL=john@example.com
TEST_USER_PASSWORD=User1234!

TEST_RECIPIENT_EMAIL=admin@bank.com
TEST_RECIPIENT_PASSWORD=Admin1234!

# Must match E2E_BYPASS_TOKEN in server/.env. Sent only on API-side requests
# from Playwright's request context to bypass the auth rate limiter.
E2E_BYPASS_TOKEN=
